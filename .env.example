# Environment
PORT=3000
NODE_ENV=development

# Timezone
# Set your local timezone (e.g., Europe/Istanbul, America/New_York, Asia/Tokyo)
# All scheduled messages and logs will use this timezone
TZ=Europe/Istanbul

# WhatsApp Session
SESSION_PATH=./public/auth_info

# WhatsApp Features
# AUTO_READ: true = automatically mark incoming messages as read
AUTO_READ=false
# NOTIFY: false = phone receives notifications (recommended for phone usage)
#         true = this app receives notifications (marks online on connect)
# WARNING: WhatsApp may auto-enable notifications, app will remind you periodically
NOTIFY=false
# CORS_WHITE_LIST: Comma-separated list of allowed domains/IPs for SSE connections
# SSE endpoints (/api/auth/qr/stream, /api/messages/stream) are protected by this list
# If empty, all origins are allowed (only for development!)
# Example: https://example.com,https://app.example.com,192.168.1.100,localhost
CORS_WHITE_LIST=

# Call Rejection Settings
# AUTO_REJECT_CALLS: true = automatically reject incoming calls
#                    false = let calls ring normally
AUTO_REJECT_CALLS=true

# Queue Settings
QUEUE_DELAY_MS=3000
QUEUE_MAX_RETRY=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Security
# Generate a secure API key or leave empty for auto-generation
# API keys should start with 'wba_' prefix
API_KEY=your_secure_api_key_here

# Cache auto-clear interval in minutes (0 = disabled)
CACHE_CLEAR_INTERVAL=0

