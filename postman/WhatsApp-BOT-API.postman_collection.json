  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Sunucu sağlık kontrolü. Sunucunun çalışıp çalışmadığını kontrol eder.\n\n**Not:** Bu endpoint authentication gerektirmez."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"ok\",\n  \"timestamp\": \"2026-02-19T12:00:00.000Z\",\n  \"uptime\": 3600,\n  \"version\": \"1.0.0\",\n  \"memory\": {\n    \"heapUsed\": 45,\n    \"heapTotal\": 78,\n    \"unit\": \"MB\"\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "SSE Streams",
      "item": [
        {
          "name": "Stream QR Code (SSE)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/qr/stream",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "qr", "stream"]
            },
            "description": "QR kodunu Server-Sent Events (SSE) ile gerçek zamanlı dinler.\n\n**Güvenlik:** CORS_WHITE_LIST'te tanımlı IP/domain'lerden erişime izin verilir.\n\n**Events:**\n- `qr`: Yeni QR kodu\n- `connected`: Bağlantı kuruldu\n- `disconnected`: Bağlantı kesildi\n- `timeout`: Zaman aşımı (2 dakika)"
          },
          "response": []
        },
        {
          "name": "Stream Messages (SSE)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/messages/stream",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages", "stream"]
            },
            "description": "Gelen mesajları Server-Sent Events (SSE) ile gerçek zamanlı dinler.\n\n**Güvenlik:** CORS_WHITE_LIST'te tanımlı IP/domain'lerden erişime izin verilir.\n\n**Query Params:**\n- `jid` (opsiyonel): Belirli bir numaradan gelen mesajları filtrele\n\n**Events:**\n- `init`: Başlangıç durumu (bağlantı bilgisi)\n- `message`: Yeni gelen mesaj\n- `sent`: Gönderilen mesaj\n- `connected`: WhatsApp bağlantısı kuruldu\n- `disconnected`: WhatsApp bağlantısı kesildi\n- `heartbeat`: Bağlantı canlı tutma (30sn)"
          },
          "response": []
        },
        {
          "name": "Stream Messages (Filtered by JID)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/messages/stream?jid={{testPhoneNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages", "stream"],
              "query": [
                {"key": "jid", "value": "{{testPhoneNumber}}"}
              ]
            },
            "description": "Belirli bir numaradan gelen mesajları gerçek zamanlı dinler."
          },
          "response": []
        }
      ]
    },
