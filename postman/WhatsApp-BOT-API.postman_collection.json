      "name": "Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Sunucu sağlık kontrolü. Authentication gerektirmez."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"ok\",\n  \"timestamp\": \"2026-02-23T12:00:00.000Z\",\n  \"uptime\": 3600,\n  \"version\": \"2.1.0\",\n  \"memory\": {\n    \"heapUsed\": 45,\n    \"heapTotal\": 78,\n    \"unit\": \"MB\"\n  }\n}"
            }
          ]
        }
      ]
