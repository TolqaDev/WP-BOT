    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "wba_dev_test_key_12345",
      "type": "string",
      "description": "API Key for authentication"
    },
    {
      "key": "testPhoneNumber",
      "value": "905551234567",
      "type": "string",
      "description": "Test için telefon numarası (ülke kodu ile)"
    }
  ],
